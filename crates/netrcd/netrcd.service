# /etc/systemd/system/netrcd.service
#
# The host-side credential broker. Runs as the user whose netrc and
# config.d it serves; holds credentials in memory only (Dumpable=no so
# a crash cannot leave a credential-bearing core on the host).

[Unit]
Description=netrcd credential broker
After=network-online.target
Wants=network-online.target

[Service]
User=%i
Type=simple
ExecStart=/usr/local/bin/netrcd \
    --socket /run/netrcd/netrcd.sock \
    --profiles-dir /etc/netrcd/profiles.d \
    --grants-dir %h/.config/netrcd/config.d \
    --netrc %h/.netrc
Dumpable=no
# SELinux (enforcing Fedora): containers may not connectto unix
# sockets owned by unconfined_t processes — the socket OBJECT carries
# the creator's context regardless of the socket FILE's label
# (verified live: EACCES enforcing, success permissive).
# container_runtime_t is the context podman's own socket uses and the
# one container_t is allowed to connect to. NOTE: this context cannot
# read credentials under user_home_t — place the netrc somewhere it
# may read (e.g. /etc/netrcd/, labeled accordingly); never relabel the
# secret itself (container_file_t credentials are readable by EVERY
# container).
SELinuxContext=system_u:system_r:container_runtime_t:s0
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
