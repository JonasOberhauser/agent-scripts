#!/bin/bash
# pre-commit: reject binary files (2026-10-06 — the fixture-binary incident, PR #11).
#
# Heuristic: git's own — a NUL byte in the first 8000 bytes means
# binary. Text sources (UTF-8, latin1, etc.) never contain NUL.
#
# Escape hatch: `git commit --no-verify` when a binary is genuinely
# intended — the hook is a tripwire, not policy; CI and review remain
# the enforcement.
block=0
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

git diff --cached --diff-filter=ACM -z --name-only > "$tmp"
while IFS= read -r -d '' f; do
    [ -f "$f" ] || continue
    head -c 8000 -- "$f" > /dev/null 2>&1 || continue
    raw=$(head -c 8000 -- "$f" | wc -c)
    nonul=$(head -c 8000 -- "$f" | tr -d '\000' | wc -c)
    if [ "$raw" -ne "$nonul" ]; then
        echo "pre-commit: BLOCKED binary file staged: $f" >&2
        echo "  (rustc fixture output? compile with --out-dir. If a binary is" >&2
        echo "   genuinely intended: git commit --no-verify)" >&2
        block=1
    fi
done < "$tmp"

exit $block
